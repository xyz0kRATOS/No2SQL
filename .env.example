# =====================================================================
# No2SQL Configuration
# Google Gemini – uses gemini-3.5-flash-lite by default (fastest, reliable)
# Other working options: gemini-3.6-flash, gemini-3.7-flash, gemini-3.8-flash
# =====================================================================

GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
SQL_DIALECT=sqlite
MAX_UPLOAD_MB=50
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=8
SHARE_SAMPLE_VALUES=true
APP_ENV=development
